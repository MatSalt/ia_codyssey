# Comma-separated exact frontend origins. Empty means no cross-origin access.
ALLOWED_ORIGINS=http://localhost:5500
FIREBASE_PROJECT_ID=story-analytics-assistant
# Absolute path to a server-only service account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=
# Enter the learning-platform virtual key locally; never commit it.
OPENAI_API_KEY=
# OpenAI-compatible gateway; uses Chat Completions.
OPENAI_BASE_URL=https://copa.codyssey.kr/v1
OPENAI_MODEL=gpt-5-mini
# Chat adapter policy: output 2048 tokens, timeout 45 seconds, retries 0.
