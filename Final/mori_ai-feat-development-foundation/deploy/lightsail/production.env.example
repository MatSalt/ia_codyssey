# Copy only on the Lightsail server to .env.production; chmod 600.
# Template only. AI stays disabled until QA spend + reservations are reconciled.
# Production template; the wrapper fixes the project name.
COMPOSE_PROJECT_NAME=mori-lightsail-prod
MORI_IMAGE=mori-ai:lightsail-initial
POSTGRES_USER=mori
POSTGRES_DB=mori
# Use URL-safe letters/digits/underscore/hyphen: Compose embeds this in DATABASE_URL.
POSTGRES_PASSWORD=
STORAGE_MODE=r2
STORAGE_ROOT=/app/media
WORKER_POLL_SECONDS=1
NORMALIZED_WEBP_LOSSLESS=false
NORMALIZED_WEBP_QUALITY=90
NORMALIZED_MAX_EDGE=4096
NORMALIZED_MAX_BYTES=20971520
RESULT_WEBP_QUALITY=90
THUMBNAIL_WEBP_QUALITY=80
THUMBNAIL_MAX_EDGE=480
# For running Python directly, explicitly provide DATABASE_URL, e.g.
# DATABASE_URL=postgresql+asyncpg://mori:<url-encoded-password>@127.0.0.1:5432/mori
# OAuth 설정은 아래 Google/Kakao 로그인 연결에 사용합니다. AI 호출은 별도 비활성입니다.

# Development auth is synthetic and explicitly opt-in; never enable in production.
APP_ENV=production
DEV_AUTH_ENABLED=false
APP_ORIGIN=https://aimori.kro.kr
# Set true only for local HTTP; HTTPS/production keeps Secure cookies.
SESSION_COOKIE_ALLOW_INSECURE_LOCAL=false
SESSION_TTL_SECONDS=86400
CONSENT_POLICY_VERSION=media-2026-10-18

# Local fake generation only; model identifiers are explicitly fake.
DEV_AI_ENABLED=false

# ============================================================================
# 실제 연동 설정 — Google/Kakao 값은 Settings/Compose에서 명시적으로 전달합니다.
# R2 adapter는 STORAGE_MODE=r2에서 연결합니다. OpenAI는 별도 명시적 활성화가 필요합니다.
# R2 사용 시 STORAGE_MODE=r2로 설정하고, DEV_*는 검증 목적일 때만 켭니다.
# 새 mori_ai 서비스 전용 자원만 사용하세요. .env는 Git/Docker build에서 제외됩니다.
# 비밀값에 $, # 등이 있으면 작은따옴표로 감싸세요: KEY='your-secret'
# ============================================================================

# Google OAuth: 웹 애플리케이션 유형의 Client ID / Client secret.
# 콘솔의 승인된 리디렉션 URI에 아래 주소를 정확하게 등록하세요.
# WEB_PORT/APP_ORIGIN을 바꾸면 두 제공자의 redirect URI도 같은 origin으로 맞추세요.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://aimori.kro.kr/api/v1/auth/google/callback

# Kakao OAuth: JavaScript 키가 아닌 REST API 키를 CLIENT_ID에 넣으세요.
# Client secret이 활성화된 앱은 해당 secret도 넣으세요.
# 카카오 로그인 Redirect URI에 아래 주소를 등록하세요.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://aimori.kro.kr/api/v1/auth/kakao/callback

# Cloudflare R2: 새 서비스 전용 비공개 bucket 및 S3 호환 자격증명.
# S3 Access Key ID / Secret Access Key를 사용합니다(Cloudflare API token 문자열 아님).
# endpoint는 R2 콘솔의 S3 API endpoint를 그대로 복사하세요.
# 일반 endpoint 예: https://<account-id>.r2.cloudflarestorage.com
# jurisdiction 제한 bucket은 콘솔에 표시되는 해당 endpoint를 사용하세요.
# bucket은 비공개로 유지합니다. 로컬 CORS JSON: docs/storage/r2-cors.local.json
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
# 새 서비스 전용 namespace. local 데이터의 자동 R2 이관은 제공하지 않습니다.
R2_KEY_PREFIX=mori-ai-prod/

# OpenAI: 새 서비스용 API 키. 브라우저/VITE_* 환경 변수에는 넣지 마세요.
OPENAI_API_KEY=
# 선택: 해당 키의 organization/project를 명시해야 할 때만 채웁니다.
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
# 글귀 모델은 설정으로 교체하고, 새 생성 run에 선택값을 고정합니다. 교체 시 가격 profile 검토가 필요합니다.
OPENAI_CAPTION_MODEL=gpt-5.4-mini
# 이미지 모델도 새 run에 고정합니다.
OPENAI_IMAGE_MODEL=gpt-image-2

# 실제 AI 검증: 이미지+글귀 합산 누적 USD 상한. 실행마다 초기화하는 값이 아닙니다.
# DB 원장이 완료 비용 + 미확인 호출 예약액을 누적 제한합니다. DB 초기화 금지.
AI_VALIDATION_BUDGET_USD=100
# 현재 사용 가능한 누적 상한; 처음에는 최대 $5 범위의 소량 검증(전체 $100에 포함).
AI_VALIDATION_INITIAL_BUDGET_USD=5
# 실제 호출은 기본 비활성. 활성화 시 DEV_AI_ENABLED=false가 필수입니다.
AI_REAL_CALLS_ENABLED=false
